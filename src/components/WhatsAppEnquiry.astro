---
// Floating WhatsApp enquiry. Small native <dialog> — collects a few details,
// then redirects to WhatsApp with the message prefilled. No JS framework.
const WA_NUMBER = '918374930568'; // +91 83749 30568
---

<!-- Floating trigger -->
<button
  id="wa-enquiry-open"
  type="button"
  aria-label="Enquire on WhatsApp"
  class="fixed bottom-24 right-6 z-[998] flex items-center gap-2 rounded-full bg-[#25D366] px-5 py-3 font-sans text-sm font-semibold text-white shadow-lg transition hover:brightness-95 active:scale-95"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.69 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43l-.48-.01c-.16 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.29Z"/>
  </svg>
  Enquire
</button>

<!-- Enquiry dialog -->
<dialog id="wa-enquiry" class="wa-dialog m-auto w-[min(92vw,26rem)] rounded-2xl border border-black/10 bg-brand-bg p-0 shadow-2xl backdrop:bg-black/40">
  <form id="wa-enquiry-form" method="dialog" class="p-6">
    <div class="mb-4 flex items-start justify-between">
      <div>
        <h2 class="font-display text-xl font-semibold text-brand-black">Quick enquiry</h2>
        <p class="mt-1 font-sans text-sm text-brand-gray">We'll continue on WhatsApp.</p>
      </div>
      <button type="button" id="wa-enquiry-close" aria-label="Close" class="rounded-full p-1 text-brand-gray transition hover:text-brand-black">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <label class="mb-3 block">
      <span class="mb-1 block font-sans text-xs font-medium text-brand-black">Name</span>
      <input name="name" type="text" required autocomplete="name" class="wa-input" />
    </label>
    <label class="mb-3 block">
      <span class="mb-1 block font-sans text-xs font-medium text-brand-black">Email</span>
      <input name="email" type="email" required autocomplete="email" class="wa-input" />
    </label>
    <label class="mb-3 block">
      <span class="mb-1 block font-sans text-xs font-medium text-brand-black">Business name</span>
      <input name="business" type="text" required class="wa-input" />
    </label>
    <label class="mb-5 block">
      <span class="mb-1 block font-sans text-xs font-medium text-brand-black">Website <span class="text-brand-gray">(optional)</span></span>
      <input name="website" type="text" inputmode="url" placeholder="yourbusiness.com" class="wa-input" />
    </label>

    <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] px-5 py-3 font-sans text-sm font-semibold text-white transition hover:brightness-95 active:scale-95">
      Send on WhatsApp
    </button>
  </form>
</dialog>

<style>
  .wa-input {
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: #fff;
    padding: 0.55rem 0.75rem;
    font-family: 'Poppins', sans-serif;
    font-size: 0.875rem;
    color: #111;
    outline: none;
  }
  .wa-input:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
  }
  .wa-dialog[open] {
    animation: wa-pop 0.18s ease-out;
  }
  /* Site hides the native cursor globally; bring it back so the form is usable. */
  .wa-dialog input { cursor: text; }
  .wa-dialog button { cursor: pointer; }
  @keyframes wa-pop {
    from { opacity: 0; transform: translateY(6px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<script is:inline define:vars={{ WA_NUMBER }}>
  const dlg = document.getElementById('wa-enquiry');
  const form = document.getElementById('wa-enquiry-form');
  document.getElementById('wa-enquiry-open')?.addEventListener('click', () => dlg?.showModal());
  document.getElementById('wa-enquiry-close')?.addEventListener('click', () => dlg?.close());

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const name = (f.get('name') || '').toString().trim();
    const email = (f.get('email') || '').toString().trim();
    const business = (f.get('business') || '').toString().trim();
    const website = (f.get('website') || '').toString().trim();
    const lines = [
      'Hi Standout Labs, I would like to enquire.',
      `Name: ${name}`,
      `Email: ${email}`,
      `Business: ${business}`,
    ];
    if (website) lines.push(`Website: ${website}`);
    const url = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(lines.join('\n'))}`;
    window.open(url, '_blank', 'noopener');
    dlg?.close();
    form.reset();
  });
</script>
